+              {withNext.length > 0 && (
+                <div className="mt-4 rounded-xl border border-stone-200 bg-white px-4 py-3">
+                  <div className="flex flex-wrap items-center gap-3">
+                    <p className="flex-1 text-sm text-stone-700">
