# Public Firebase web config (safe to commit — these are client identifiers,
# protected by Firestore Security Rules, not secrets). Used by the cloud build.
VITE_FIREBASE_API_KEY=AIzaSyCARj9STxOIYX26a3TXw5CHVN6JaLbZGe4
# Deliberately the Hosting domain, not firebaseapp.com. Same origin as the app,
# so the sign in handler is not third party storage. Without this, signing in
# from an in-app browser (a link tapped inside Messages or Slack) fails with
# "missing initial state" on iOS.
VITE_FIREBASE_AUTH_DOMAIN=tiles-4972a.web.app
VITE_FIREBASE_PROJECT_ID=tiles-4972a
VITE_FIREBASE_STORAGE_BUCKET=tiles-4972a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=470967705641
VITE_FIREBASE_APP_ID=1:470967705641:web:90f07a05dfce2ada65bc38
